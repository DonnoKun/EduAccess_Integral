{
  "rewrites": [
    { "source": "/assets/:all*", "destination": "/assets/:all*" },
    { "source": "/media/:all*", "destination": "/media/:all*" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/registerSW.js", "destination": "/registerSW.js" },
    { "source": "/manifest.webmanifest", "destination": "/manifest.webmanifest" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/favicon.png", "destination": "/favicon.png" },
    { "source": "/og-image.png", "destination": "/og-image.png" },
    { "source": "/placeholder.svg", "destination": "/placeholder.svg" },
    { "source": "/pwa-192x192.png", "destination": "/pwa-192x192.png" },
    { "source": "/pwa-512x512.png", "destination": "/pwa-512x512.png" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
